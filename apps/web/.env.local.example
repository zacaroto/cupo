# Copy to apps/web/.env.local (git-ignored). Values come from `supabase status`
# for the local stack; hosted values live only in the Vercel project settings.

# Supabase project URL. Local stack: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server only: read exclusively in
# src/lib/supabase/admin.ts behind `server-only`. Never NEXT_PUBLIC_, never committed.
SUPABASE_SECRET_KEY=
