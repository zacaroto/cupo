{
  "name": "cupo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @cupo/web",
    "build": "npm run build -w @cupo/web",
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces --if-present",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db --no-file-parallelism",
    "db:types": "node scripts/db-types.ts",
    "db:seed-users": "node scripts/seed-users.ts",
    "db:seat-drift": "node scripts/seat-drift.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^22",
    "eslint": "^9",
    "postgres": "^3.4.9",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@swc/core-linux-x64-gnu": "*",
    "@swc/core-linux-x64-musl": "*",
    "@tailwindcss/oxide-linux-x64-gnu": "*",
    "@tailwindcss/oxide-linux-x64-musl": "*",
    "lightningcss-linux-x64-gnu": "*",
    "lightningcss-linux-x64-musl": "*"
  }
}
